# ============================================================
# Web Scraper Frontend - Next.js 15 + Playwright
# ============================================================
FROM node:20-slim AS base

# 시스템 의존성 설치 (Playwright 및 한글 폰트)
RUN apt-get update && apt-get install -y \
    # Playwright 의존성
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libatspi2.0-0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    # 한글 폰트
    fonts-nanum \
    # 기타 유틸리티
    ca-certificates \
    wget \
    gosu \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ============================================================
# Dependencies Stage
# ============================================================
FROM base AS deps

# package.json 복사
COPY frontend/package.json frontend/package-lock.json ./

# 의존성 설치
RUN npm ci

# Playwright 브라우저 설치 (Chromium만)
RUN npx playwright install chromium

# ============================================================
# Builder Stage
# ============================================================
FROM base AS builder

WORKDIR /app

# 의존성 복사
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /root/.cache/ms-playwright /root/.cache/ms-playwright

# 소스 코드 복사
COPY frontend/ ./

# 환경 변수 (빌드 시)
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Next.js 빌드
RUN npm run build

# ============================================================
# Production Stage
# ============================================================
FROM base AS runner

WORKDIR /app

# 환경 변수
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV PLAYWRIGHT_BROWSERS_PATH="/root/.cache/ms-playwright"

# 비root 사용자 생성
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# 필요한 파일 복사
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

# sql.js WASM 파일 복사 (standalone 빌드에 포함되지 않는 문제 해결)
COPY --from=deps /app/node_modules/sql.js/dist/sql-wasm.wasm ./node_modules/sql.js/dist/sql-wasm.wasm

# Playwright 브라우저 복사 및 nextjs 사용자 접근 권한 설정
COPY --from=deps /root/.cache/ms-playwright /root/.cache/ms-playwright
RUN chmod -R o+rx /root/.cache/ms-playwright

# 기본 데이터 파일을 별도 위치에 백업 (볼륨 마운트 시 복원용)
COPY --from=builder /app/data ./data-defaults

# Entrypoint 스크립트 복사 (Windows CRLF → LF 변환)
COPY frontend/docker-entrypoint.sh ./docker-entrypoint.sh
RUN sed -i 's/\r$//' /app/docker-entrypoint.sh

# 데이터 디렉토리 생성 및 권한 설정
RUN mkdir -p /app/data /app/save /app/chunk && \
    chmod +x /app/docker-entrypoint.sh && \
    chown -R nextjs:nodejs /app

# 포트 노출
EXPOSE 3000

# 헬스체크
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1

# root로 entrypoint 실행 (볼륨 권한 수정 후 nextjs 사용자로 서버 시작)
CMD ["/bin/sh", "/app/docker-entrypoint.sh"]
