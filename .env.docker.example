# ============================================================
# Web Scraper - Docker 환경 변수 설정
# ============================================================
#
# 사용법:
#   1. 이 파일을 '.env.docker'로 복사
#   2. 실제 값으로 수정
#   3. docker-compose up 실행
#
# 주의: .env.docker 파일은 절대 Git에 커밋하지 마세요!
#
# ============================================================

# ------------------------------------------------------------
# AI API 키 (필수 - 최소 1개 이상 설정)
# ------------------------------------------------------------

# OpenAI API 키 (GPT, 임베딩)
OPENAI_API_KEY=sk-proj-여기에_실제_키_입력

# Google Gemini API 키
GEMINI_API_KEY=여기에_실제_키_입력

# Anthropic Claude API 키
ANTHROPIC_API_KEY=sk-ant-여기에_실제_키_입력
ANTHROPIC_MODEL=claude-4-5-sonnet-latest

# ------------------------------------------------------------
# GitHub 동기화 설정 (필수 - GitHub Actions 동기화용)
# ------------------------------------------------------------

# GitHub Personal Access Token
# 발급: GitHub > Settings > Developer settings > Personal access tokens
# 권한: repo, workflow
GITHUB_TOKEN=ghp_여기에_실제_토큰_입력

# GitHub 저장소 (owner/repo 형식)
GITHUB_REPO=your-username/your-repository

# ------------------------------------------------------------
# Cloudflare R2 스토리지 설정 (Railway 배포 시 필수)
# ------------------------------------------------------------

# Cloudflare Account ID (Cloudflare 대시보드에서 확인)
# R2_ACCOUNT_ID=

# R2 S3 호환 엔드포인트 (https://<account-id>.r2.cloudflarestorage.com)
# R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# R2 API 토큰 (Cloudflare R2 > Manage R2 API Tokens에서 생성)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# R2 버킷 이름 (기본: webscraper-data)
# R2_BUCKET_NAME=webscraper-data

# ------------------------------------------------------------
# 스크래퍼 설정 (선택)
# ------------------------------------------------------------

# 국가법령정보센터 API (사용 시)
SCRAPER_LAW_OC=kaikan00

# ------------------------------------------------------------
# 동기화 서비스 설정 (선택 - 기본값 있음)
# ------------------------------------------------------------

# 동기화 주기 (초) - 기본: 3600 (1시간)
# SYNC_INTERVAL=3600

# 동기화 범위 (시간) - 기본: 24
# SYNC_HOURS=24
